# ─────────────────────────────────────────────────────────────────────────────
# Marketivity Environment Variables Example
# Duplicate this file to .env.local for local development or configure in Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# Resend API Key (Get your free key from https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Recipient email that receives contact form submissions
CONTACT_TO_EMAIL=marketivitybd@gmail.com

# Sender email address
# On Resend free tier before domain verification, use: onboarding@resend.dev
# After domain verification on Resend, use: notifications@yourdomain.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Production site URL (optional for metadata/canonical)
NEXT_PUBLIC_SITE_URL=https://marketivity.vercel.app
